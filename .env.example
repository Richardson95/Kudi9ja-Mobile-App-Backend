# Kudi9ja backend — configuration
#
# Copy to .env for local use, or paste these into your host's environment.
# NOTHING in this file should ever hold a real value in source control.

# ── Required. The application will not start without these. ────────────────

# A long random string, held only in secret configuration. The Flutter client
# shipped a hard-coded pepper that is now in public git history — generate a
# fresh one and never reuse that value.
#   openssl rand -base64 48
KUDI9JA_PEPPER=

# Signs the access and refresh tokens. At least 32 bytes.
#   openssl rand -base64 48
KUDI9JA_JWT_SECRET=

# Which provider checks a BVN and an NIN, and resolves a bank account name.
# Left empty the application refuses to start, deliberately: something that
# looks like a check and is not one is worse than no check.
#   dojah         — a licensed provider actually checks
#   self-declared — the customer's word, taken as given. An account can be
#                   opened in somebody else's name and the payout account is
#                   unverified. A business decision, not a default.
#   sandbox       — local only
KYC_PROVIDER=

# ── Database ───────────────────────────────────────────────────────────────
# From Neon. Keep the app server in the same region as the database.
DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=

# ── Email (Resend) ─────────────────────────────────────────────────────────
MAIL_ENABLED=true
RESEND_API_KEY=
MAIL_FROM=no-reply@kudi9ja.com

# ── Identity (Dojah) ───────────────────────────────────────────────────────
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://api.dojah.io

# ── Push (Firebase) ────────────────────────────────────────────────────────
# Empty means no push: notifications still appear when the app is opened.
PUSH_PROVIDER=
FIREBASE_SERVICE_ACCOUNT=/etc/secrets/firebase-service-account.json

# ── Receipt storage ────────────────────────────────────────────────────────
# local      the filesystem. Fine on one machine, wrong on Render — its disk is
#            discarded on every deploy, so receipts would disappear while the
#            claims still pointed at them.
# cloudinary object storage. Survives a deploy. Set the three values below.
RECEIPT_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kudi9ja/receipts

# ── The first owner ────────────────────────────────────────────────────────
# When an account is opened with this email, and only then, owner access is
# granted. Empty means nobody can reach the admin panel.
KUDI9JA_OWNER_EMAIL=

# ── Everything else has a sensible default ─────────────────────────────────
PORT=8080
JOBS_ENABLED=true
LOG_LEVEL=INFO
CORS_ORIGINS=
